@page "/classes/edit/{classId}"
@using Zick.GameScheduler.Backend.Data.Dashboard.Forms
@using Zick.GameScheduler.Backend.Data.DTOs
@using Zick.GameScheduler.Services.Data
@inject IRacingClassService ClassService
@inject IVehicleService VehicleService 
@inject NavigationManager Nav
@inject ISnackbar SnackbarService

<PageTitle>ZGS | Edit Class</PageTitle>
<TitleComponent Title="Edit Class"/>

<MudContainer MaxWidth="MaxWidth.Medium"
              Gutters="false">
    <MudTextField Label="Abbreviation"
                  Disabled="true"
                  @bind-Value="Form.Identifier"/>
    <MudTextField Label="Name"
                  @bind-Value="Form.Name"
                  Placeholder="Grand Touring 3"/>
    <MudTextField Label="Color"
                  @bind-Value="Form.Color"
                  Placeholder="#ababab"/>
    <MudContainer Gutters="false" Class="d-flex align-center">
        <MudSelect @bind-Value="SelectedVehicle" Label="Add Car" Placeholder="Please Select a car...">
            @foreach (var car in Cars)
            {
                <MudSelectItem Value="car">@($"{car.Manufacturer} {car.Model}".Trim())</MudSelectItem>
            }
        </MudSelect>
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" @onclick="AddCar" />
    </MudContainer>
    @if (Form.Cars.Count > 0)
    {
        <MudText>Added cars:</MudText>
        <MudGrid>
            @foreach (var car in Form.Cars)
            {
                <MudItem>
                    
                    <MudChip T="string"
                             OnClose="()=>ReturnCar(car)"
                             CloseIcon="@Icons.Material.Filled.Close"
                             Color="Color.Primary">
                        @($"{car.Manufacturer} {car.Model}".Trim())
                    </MudChip>
                </MudItem>
            }
        </MudGrid>
    }
    <MudButton Color="Color.Primary" Variant="Variant.Outlined" @onclick="Submit">Submit</MudButton>
</MudContainer>


@code {
    [Parameter]
    public string classId { get; set; }
    
    EditRacingClassForm Form { get; set; } = new()
    {
        Identifier = string.Empty,
        Name = string.Empty,
        Color = null,
        Cars = []
    };

    IEnumerable<CarDTO> Cars { get; set; } = [];
    CarDTO? SelectedVehicle { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        Cars = await VehicleService.GetVehicles();
        var cls = await ClassService.GetClass(classId);

        Form.Identifier = cls.Abbreviation;
        Form.Name = cls.Name;
        Form.Color = cls.Color;
        Form.Cars = cls.Cars;

        Cars = Cars.Except(Form.Cars);
        
        await base.OnInitializedAsync();
    }

    void AddCar()
    {
        if (SelectedVehicle != null)
        {
            CarDTO car = SelectedVehicle;
            Form.Cars.Add(car);
            Cars = Cars.Where(x => x.Id != car.Id);
            SelectedVehicle = null;
        }
    }
    
    void ReturnCar(CarDTO car)
    {
        CarDTO c = car;
        Cars = [c, .. Cars];
        Form.Cars = [..Form.Cars.Where(x => x.Id != car.Id)];
    }

    async Task Submit()
    {
        try
        {
            await ClassService.ModifyClass(Form);
            Nav.NavigateTo("/classes/overview");
        }
        catch (Exception e)
        {
            SnackbarService.Add(severity: Severity.Error, message: e.Message);
        }
    }

}