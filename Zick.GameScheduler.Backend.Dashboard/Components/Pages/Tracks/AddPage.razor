@page "/tracks/add"
@using Zick.GameScheduler.Backend.Data.Dashboard.Forms
@using Zick.GameScheduler.Services.Data
@inject ITrackService TrackService
@inject NavigationManager NavManager
@inject ISnackbar SnackbarService

<PageTitle>ZGS | Add track</PageTitle>
<TitleComponent Title="Add new track"/>

<MudForm>
    <MudContainer Gutters="false" Class="ms-0" MaxWidth="MaxWidth.Medium">
        <MudTextField T="string"
                      @bind-Value="Form.Name"
                      Label="Track Name"
                      Class="mb-3"
                      Placeholder="Hockenheim"/>
        <MudTextField T="string"
                      @bind-Value="Form.CountryCode"
                      Label="Country Code (optional)"
                      Class="mb-3"
                      Placeholder="GER"/>
        <MudTextField T="string"
                      @bind-Value="Form.Folder"
                      Label="Folder Name"
                      Class="mb-3"
                      Placeholder="ks_hockenheim"/>
        <MudNumericField Label="MaxParticipants"
                         @bind-Value="Form.MaxParticipants"
                         Class="mb-3"
                         Min="0"/>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   @onclick="Submit">Submit
        </MudButton>    
    </MudContainer>
</MudForm>


@code {
    AddTrackForm Form { get; } = new();
    async Task Submit()
    {  
        try
        {
            await TrackService.AddTrack(Form);
            NavManager.NavigateTo("/tracks/overview");
        }
        catch (Exception e)
        {
            SnackbarService.Add(severity: Severity.Error, message: e.Message);
        }
    }
}