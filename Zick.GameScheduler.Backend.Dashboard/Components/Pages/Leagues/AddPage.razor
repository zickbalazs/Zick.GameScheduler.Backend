@page "/leagues/add"
@using Zick.GameScheduler.Backend.Dashboard.Common
@using Zick.GameScheduler.Backend.Data.Dashboard.Forms
@using Zick.GameScheduler.Backend.Data.DTOs
@using Zick.GameScheduler.Services.Data
@inject ISnackbar SnackbarService
@inject IRacingClassService ClassService
@inject ITrackService TrackService
@inject ILeagueService LeagueService

<PageTitle>ZGS | Add League</PageTitle>
<TitleComponent Title="Add new league"/>

<MudForm>
    <MudGrid Class="mb-3">
        <MudItem xs="Constants.GridXsSize" md="Constants.GridMdSize">
            <MudTextField @bind-Value="Form.Name"
                          Label="League Name"
                          Placeholder="Clown Racing League"/>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mb-3">
        <MudItem xs="Constants.GridXsSize" md="Constants.GridMdSize">
            <MudTextField @bind-Value="Form.Description"
                          Label="Description"
                          Placeholder="Lorem ipsum"/>
        </MudItem>
    </MudGrid>
    <MudDivider Class="my-3"/>
    <MudGrid Class="mb-3">
        <MudItem xs="Constants.GridXsSize" md="Constants.GridMdSize">
            <MudText>Select Racing Classes:</MudText>
            <MudContainer Class="d-flex align-center">
                <MudSelect @bind-Value="SelectedClass">
                    @foreach (var racingClass in Classes)
                    {
                        <MudSelectItem Value="racingClass">@racingClass.Name | @racingClass.Abbreviation</MudSelectItem>
                    }
                </MudSelect>
                <MudIconButton Icon="@Icons.Material.Filled.Add"
                               Color="Color.Primary"
                               Disabled="ClassButtonDisabled"
                               @onclick="AddSelectedClass"/>
            </MudContainer>
            @if (Form.RacingClasses.Count > 0)
            {
                <MudContainer Class="d-flex">
                    @foreach (var raceClass in Form.RacingClasses)
                    {
                        <MudChip T="RacingClassDTO"
                                 CloseIcon="@Icons.Material.Filled.Close"
                                 OnClose="()=>RemoveClass(raceClass)">@raceClass.Abbreviation</MudChip>
                    }
                </MudContainer>                
            }
        </MudItem>
    </MudGrid>
    <MudDivider Class="my-3"/>
    <MudText>Select Track:</MudText>
    <MudGrid Class="mb-3">
        <MudItem xs="Constants.GridXsSize" md="Constants.GridMdSize">
            
                <MudSelect @bind-Value="SelectedTrack">
                    @foreach (var track in Tracks)
                    {
                        <MudSelectItem Value="track">
                            @track.Name
                        </MudSelectItem>
                    }
                </MudSelect>
        </MudItem>
    </MudGrid>


    <MudGrid>
        <MudItem xs="Constants.GridXsSize" md="Constants.GridMdSize">
            <MudButton StartIcon="@Icons.Material.Filled.Done">Submit</MudButton>
        </MudItem>
    </MudGrid>
</MudForm>


@code {

    IEnumerable<RacingClassDTO> Classes { get; set; } = [];
    IEnumerable<TrackDTO> Tracks { get; set; } = [];

    TrackDTO? SelectedTrack { get; set; }
    RacingClassDTO? SelectedClass { get; set; }

    bool ClassButtonDisabled => SelectedClass == null;
    
    
    AddLeagueForm Form { get; } = new()
    {
        Name = string.Empty,
        Description = null,
        PracticeData = null,
        QualifyData = null,
        Race = null,
        Interval = TimeSpan.FromHours(1),
        Duration = new DateRange(),
        CurrentTrack = null,
        RacingClasses = new List<RacingClassDTO>()
    };

    async Task Submit()
    {
        try
        {
            await LeagueService.AddLeague(Form);
        }
        catch (Exception e)
        {
            SnackbarService.Add(severity: Severity.Error, message: e.Message);
        }
    }

    void AddSelectedClass()
    {
        if (SelectedClass != null)
        {
            var cls = SelectedClass;
            Form.RacingClasses.Add(cls);
            Classes = Classes.Where(x => x.Abbreviation != cls.Abbreviation).OrderBy(x=>x.Abbreviation);
            SelectedClass = null;
        }
    }

    void RemoveClass(RacingClassDTO cls)
    {
        Form.RacingClasses.Remove(cls);
        Classes = Classes.Append(cls).OrderBy(x=>x.Abbreviation);
    }
    
    protected override async Task OnInitializedAsync()
    {
        Classes = await ClassService.GetClasses();
        Tracks = await TrackService.GetTracks();
        await base.OnInitializedAsync();
    }

}